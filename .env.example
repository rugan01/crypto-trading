# Public historical market-data workflows do not require credentials.
# Private account reconciliation requires a Delta India API key whose IP whitelist
# includes the machine running the script. Never commit the real .env file.
API_KEY=
API_SECRET=
DELTA_TESTNET_API_KEY=
DELTA_TESTNET_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Execution is sandbox-only unless both values are deliberately changed.
DELTA_ENV=testnet
DELTA_DRY_RUN=true
